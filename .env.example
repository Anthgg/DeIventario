# =============================================================================
# INVENTARIO DEDALO - BACKEND (FastAPI)
# F000.1 - Plantilla de variables de entorno
# -----------------------------------------------------------------------------
# Copia este archivo a `.env` y completa los valores reales:
#   PowerShell :  Copy-Item .env.example .env
#   Bash       :  cp .env.example .env
#
# REGLAS:
#   - NUNCA subir `.env` al repositorio (esta en .gitignore).
#   - NUNCA incluir secretos reales en este archivo de ejemplo.
#   - SUPABASE_SERVICE_ROLE_KEY solo puede existir en backend/servidor.
# =============================================================================

# --------------------------------- APP ---------------------------------------
APP_ENV=
APP_NAME=InventarioDedalo
APP_VERSION=0.1.0
APP_DEBUG=
APP_TIMEZONE=America/Lima
APP_LOCALE=es-PE
APP_CURRENCY=PEN
# Equivalentes canonicos: DEFAULT_TIMEZONE / DEFAULT_CURRENCY

# --------------------------------- API ---------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
API_DOCS_ENABLED=

# ------------------------------- SECURITY ------------------------------------
SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=inventario-dedalo
JWT_AUDIENCE=inventario-dedalo-api
PASSWORD_HASH_SCHEME=bcrypt

# ------------------------------- DATABASE ------------------------------------
# EJEMPLO FALSO. Nunca poner datos reales.
DATABASE_URL=postgresql://USER:***@HOST:5432/DATABASE?sslmode=require
# Alternativa desglosada (opcional; DATABASE_URL tiene prioridad)
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SCHEMA=public
DATABASE_ECHO=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Supabase (se completara en fases posteriores; NO usar cloud todavia)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Opcionales (nombres modernos). Si existen, tienen prioridad sobre anon/service_role.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --------------------------------- CORS --------------------------------------
FRONTEND_URL=http://localhost:5173
# Lista separada por comas. Ej.: http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# -------------------------------- STORAGE ------------------------------------
# Nombres canonicos usados por app/core/config.py
UPLOAD_DIR=./storage/uploads
EXPORT_DIR=./storage/exports
EVIDENCE_DIR=./storage/evidence
MAX_UPLOAD_MB=25
# Evidencia de dano (imagenes jpeg/png/webp; ver app/core/config.py)
MAX_EVIDENCE_MB=8
# Alias heredados (equivalentes a los anteriores; se aceptan ambos)
STORAGE_BACKEND=local
STORAGE_ROOT=./storage
STORAGE_UPLOADS_DIR=./storage/uploads
STORAGE_EXPORTS_DIR=./storage/exports
STORAGE_EVIDENCE_DIR=./storage/evidence
STORAGE_MAX_UPLOAD_MB=25

# -------------------------------- LOGGING ------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=console
LOG_DIR=./logs
LOG_FILE=backend.log
